{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "QT_NO_PRIVATE_MODULE_WARNING": "ON",
                "BUILD_DESKTOP_UI": "OFF",
                "BUILD_MOBILE_UI": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_BENCHMARKS": "OFF",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "description": "Optimized build with debug symbols",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "debug-ninja",
            "displayName": "Debug (Ninja)",
            "description": "Debug with Ninja generator",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-ninja",
            "displayName": "Release (Ninja)",
            "description": "Release with Ninja",
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "vcpkg-base",
            "hidden": true,
            "inherits": "base",

            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
                "VCPKG_MANIFEST_MODE": "ON",
                "QT_CREATOR_SKIP_MAINTENANCE_TOOL_PROVIDER": "ON",

                "CMAKE_TOOLCHAIN_FILE": {
                    "type": "FILEPATH",
                    "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
                }
            }
        },
        {
            "name": "debug-vcpkg-msvc",
            "displayName": "Debug MSVC (vcpkg-core)",
            "description": "Debug with vcpkg and MSVC",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "VCPKG_HOST_TRIPLET": "x64-windows",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "release-vcpkg-msvc",
            "displayName": "Release MSVC (vcpkg-core)",
            "description": "Release with vcpkg and MSVC",
            "inherits": "vcpkg-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_BUILD_TYPE": "release",
                "VCPKG_HOST_TRIPLET": "x64-windows",
                "VCPKG_TARGET_TRIPLET": "x64-windows-release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "debug-homebrew",
            "displayName": "Debug (Homebrew - macOS)",
            "description": "Debug with Homebrew",
            "inherits": "base",
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "/opt/exiv2;/opt/oiio;/opt/homebrew;/usr/local"
            }
        },
        {
            "name": "release-homebrew",
            "displayName": "Release (Homebrew - macOS)",
            "description": "Release with Homebrew",
            "inherits": "base",
            "generator": "Ninja",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "/opt/exiv2;/opt/oiio;/opt/homebrew;/usr/local"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo",
            "displayName": "Build RelWithDebInfo"
        },
        {
            "name": "debug-ninja",
            "configurePreset": "debug-ninja",
            "displayName": "Build Debug (Ninja)"
        },
        {
            "name": "release-ninja",
            "configurePreset": "release-ninja",
            "displayName": "Build Release (Ninja)"
        },
        {
            "name": "debug-vcpkg-msvc",
            "configurePreset": "debug-vcpkg-msvc",
            "configuration": "Debug",
            "displayName": "Build Debug MSVC (vcpkg)"
        },
        {
            "name": "release-vcpkg-msvc",
            "configurePreset": "release-vcpkg-msvc",
            "configuration": "Release",
            "displayName": "Build Release MSVC (vcpkg)"
        },
        {
            "name": "debug-homebrew",
            "configurePreset": "debug-homebrew",
            "displayName": "Build Debug (Homebrew)"
        },
        {
            "name": "release-homebrew",
            "configurePreset": "release-homebrew",
            "displayName": "Build Release (Homebrew)"
        }
    ],
    "testPresets": [
        {
            "name": "debug-vcpkg-msvc",
            "configurePreset": "debug-vcpkg-msvc",
            "configuration": "Debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "release-vcpkg-msvc",
            "configurePreset": "release-vcpkg-msvc",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "debug-ninja",
            "configurePreset": "debug-ninja",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "release-ninja",
            "configurePreset": "release-ninja",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "debug-homebrew",
            "configurePreset": "debug-homebrew",
            "displayName": "Build Debug (Homebrew)"
        },
        {
            "name": "release-homebrew",
            "configurePreset": "release-homebrew",
            "displayName": "Build Release (Homebrew)"
        }
    ]
}
